#!/usr/bin/env sh
# Gradle wrapper script (Unix)
# Generated by Gradle 8.5 wrapper template
set -e
if [ -z "$JAVA_HOME" ]; then
  JAVACMD="`command -v java || true`"
else
  JAVACMD="$JAVA_HOME/bin/java"
fi
if [ -z "$JAVACMD" ]; then
  echo "ERROR: Java not found. Please set JAVA_HOME or install Java."
  exit 1
fi
APPNAME=`basename "$0"`
PRG="$0"
# resolve symlinks
while [ -h "$PRG" ]; do
  ls=`ls -ld "$PRG"`
  link=`expr "$ls" : '.*-> \(.*\)$'`
  if expr "$link" : '/.*' > /dev/null; then
    PRG="$link"
  else
    PRG=`dirname "$PRG"`"/"`expr "$link" : '\(.*\)$'`
  fi
done
PRGDIR=`dirname "$PRG"`
exec "$JAVACMD" -cp "$PRGDIR/gradle/wrapper/gradle-wrapper.jar" org.gradle.wrapper.GradleWrapperMain "$@"
